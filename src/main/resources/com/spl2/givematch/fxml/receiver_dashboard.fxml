<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-padding: 10;" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" fx:controller="com.spl2.givematch.ui.ReceiverDashboardController">
    
    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10; -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
            <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Logout" onAction="#onLogout" />
        </HBox>
    </top>
    
    <!-- Main Content -->
    <center>
        <TabPane style="-fx-padding: 15;">
            
            <!-- Tab 1: Browse Donations -->
            <Tab text="Browse Available Items" closable="false">
                <VBox spacing="12" style="-fx-padding: 15;">
                    <HBox spacing="10">
                        <Label text="Category:" prefWidth="80" />
                        <ComboBox fx:id="categoryFilterComboBox" HBox.hgrow="ALWAYS" />
                        <Button text="Refresh" onAction="#onRefreshDonations" />
                    </HBox>
                    
                    <TableView fx:id="donationsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Item" fx:id="colBrowseDescription" prefWidth="150" />
                            <TableColumn text="Category" fx:id="colBrowseCategory" prefWidth="120" />
                            <TableColumn text="Available" fx:id="colBrowseRemaining" prefWidth="80" />
                        </columns>
                    </TableView>
                    
                    <HBox spacing="10">
                        <Label text="Quantity:" prefWidth="80" />
                        <TextField fx:id="requestQuantityField" promptText="How many do you need?" HBox.hgrow="ALWAYS" />
                        <Button text="Request Selected Item" onAction="#onCreateRequest" />
                    </HBox>
                    
                    <Label fx:id="requestErrorLabel" style="-fx-text-fill: #e74c3c; -fx-wrap-text: true;" />
                </VBox>
            </Tab>
            
            <!-- Tab 2: My Requests -->
            <Tab text="My Requests" closable="false">
                <VBox spacing="12" style="-fx-padding: 15;">
                    <Button text="Refresh" onAction="#onRefreshMyRequests" />
                    
                    <TableView fx:id="myRequestsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Item" fx:id="colMyRequestDonation" prefWidth="150" />
                            <TableColumn text="Requested" fx:id="colMyRequestQuantity" prefWidth="80" />
                            <TableColumn text="Allocated" fx:id="colMyRequestAllocated" prefWidth="80" />
                            <TableColumn text="Status" fx:id="colMyRequestStatus" prefWidth="100" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Tab 3: Standing Needs -->
            <Tab text="Standing Needs" closable="false">
                <VBox spacing="12" style="-fx-padding: 15;">
                    <HBox spacing="10">
                        <Label text="Category:" prefWidth="80" />
                        <ComboBox fx:id="needCategoryComboBox" HBox.hgrow="ALWAYS" />
                        <Label text="Quantity:" prefWidth="80" />
                        <TextField fx:id="needQuantityField" promptText="Quantity needed" prefWidth="100" />
                        <Button text="Register Need" onAction="#onRegisterNeed" />
                    </HBox>
                    
                    <Label fx:id="needErrorLabel" style="-fx-text-fill: #e74c3c; -fx-wrap-text: true;" />
                    
                    <Button text="Refresh" onAction="#onRefreshMyNeeds" />
                    
                    <TableView fx:id="myNeedsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Category" fx:id="colNeedCategory" prefWidth="150" />
                            <TableColumn text="Quantity Needed" fx:id="colNeedQuantity" prefWidth="100" />
                            <TableColumn text="Status" fx:id="colNeedStatus" prefWidth="100" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- Tab 4: Notifications -->
            <Tab text="Notifications" closable="false">
                <VBox spacing="12" style="-fx-padding: 15;">
                    <Button text="Refresh" onAction="#onRefreshNotifications" />
                    <ListView fx:id="notificationsListView" VBox.vgrow="ALWAYS" />
                </VBox>
            </Tab>
            
        </TabPane>
    </center>
</BorderPane>
