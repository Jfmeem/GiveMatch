<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="16" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.spl2.givematch.ui.RegisterController">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Button text="← Back" onAction="#onBackToLogin" />
        <Label text="Create Your Account" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    </HBox>
    
    <Separator />
    
    <ScrollPane fitToWidth="true">
        <VBox spacing="12" style="-fx-padding: 20;">
            <HBox spacing="10">
                <Label text="Full Name:" prefWidth="100" />
                <TextField fx:id="nameField" promptText="Your full name" HBox.hgrow="ALWAYS" />
            </HBox>
            
            <HBox spacing="10">
                <Label text="Username:" prefWidth="100" />
                <TextField fx:id="usernameField" promptText="your_username" HBox.hgrow="ALWAYS" />
            </HBox>
            
            <HBox spacing="10">
                <Label text="Contact:" prefWidth="100" />
                <TextField fx:id="contactField" promptText="01700000000 or email" HBox.hgrow="ALWAYS" />
            </HBox>
            
            <HBox spacing="10">
                <Label text="Password:" prefWidth="100" />
                <PasswordField fx:id="passwordField" promptText="Enter a strong password" HBox.hgrow="ALWAYS" />
            </HBox>
            
            <HBox spacing="10">
                <Label text="I am a:" prefWidth="100" />
                <ComboBox fx:id="roleComboBox" HBox.hgrow="ALWAYS" />
            </HBox>
            
            <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-wrap-text: true;" />
            
            <Button text="Create Account" onAction="#onRegister" style="-fx-font-size: 14px; -fx-padding: 10;" />
        </VBox>
    </ScrollPane>
</VBox>
